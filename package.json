{
  "name": "sms-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/adapters/node/main.ts",
    "start": "node dist/adapters/node/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:core": "node scripts/check-core-purity.mjs",
    "check": "pnpm typecheck && pnpm lint:core && pnpm test && pnpm audit:deps",
    "audit:deps": "node scripts/audit-deps.mjs",
    "deploy:arm": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.21.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
