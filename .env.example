# 复制成 .env 再改。docker compose 会自动读取。

# 数据密钥：短信正文、渠道凭证都用它加密。生成方式：
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
# 只生成一次。丢了 = 所有历史消息永久无法解密，没有找回办法。
# 备份它，并且不要和 data/ 放在同一个地方。
GW_DEK=

# 对外访问地址。配对二维码、Bark 深链都用它，填错会导致手机连不上。
GW_BASE_URL=https://gw.example.com

# 走反向代理（宝塔 / 1Panel / Nginx / Caddy）时必填：可信反代的网段。
# 不要写 0.0.0.0/0 —— 那样任何人都能伪造来源 IP，限速与登录告警会同时失效。
# GW_TRUSTED_PROXY=172.17.0.0/16

# 自建 Bark 的内部地址。用 compose 自带的 bark 服务时就是这个值。
# GW_BARK_UPSTREAM=http://bark:8080

# 本项目 docker 网络的网段。默认 172.27.0.0/16。
# 这台机器上已经有网络占了这个段时，docker compose up 会报 Pool overlaps 停下来
# ——那是好事，比静默把信任网段配歪强。真占了就换一个空闲段，
# 并且**和上面的 GW_TRUSTED_PROXY 改成同一个值**：两处不一致的话容器照常启动，
# 但所有请求的来源都会变成同一个网桥地址，限速按单一 IP 算、异地登录告警永不触发。
# GW_SUBNET=172.27.0.0/16
