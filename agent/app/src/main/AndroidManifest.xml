<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 采集 -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 双卡时用来取本机号码尾号（只取后 4 位）。和 READ_PHONE_STATE 同属
         PHONE 权限组，后者已授权时系统会直接放行，不多弹一次框 -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- 设备找回：按需定位，不做持续跟踪 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      Android 10+ 起，应用在后台时访问位置需要这个权限。网关平时就是后台运行的，
      没有它「查找设备」只在你恰好打开 App 时才有效，那就失去意义了。
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      Android 11+ 起，应用默认只能看到自己和少数系统应用。不声明这个权限的话
      「列出已安装应用供选择通知捕获对象」只会返回本应用一个，功能形同虚设。
      仅用于让用户在控制台里挑选应用，不做任何其他用途。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 扫码配对。只在用户主动点「扫码」时才申请 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 上报 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 短信指令要回答「WiFi 开没开」，只读状态，不改 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--

      roundIcon 的资源一直都在，但从没在清单里引用过，等于白画——

      部分 ROM（三星、一加的某些版本）优先取它。

    -->

    <application
        android:name=".App"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Agent">

        <!--
          zxing 的扫码页**默认是横屏的**：zxing-android-embedded 的库清单里写着
          android:screenOrientation="sensorLandscape"，合并后原样生效。
          于是每一次扫码配对，人都得把手机横过来对着电脑屏幕上的二维码。

          `ScanOptions.setOrientationLocked(false)` 压不住它——CaptureManager 那个
          参数只决定「要不要额外调 setRequestedOrientation 去锁」，传 false 等于
          什么都不做，清单里的 sensorLandscape 就是最终值。所以只能在这里覆盖。

          用 fullUser 而不是 portrait：尊重用户自己的旋转设置，横着扫也允许。
          配合 setOrientationLocked 的默认值 true，CaptureManager 会在打开那一刻
          把方向钉在「他此刻拿着的方向」，扫码途中不会因转屏重建。
        -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullUser"
            tools:replace="android:screenOrientation" />

        <!--
          configChanges 这一串：这一页是纯 ScrollView + 线性布局，配置变更不需要
          重新 inflate，而重建的代价很实在——配对请求原来挂在 lifecycleScope 上，
          转一次屏就把一次性配对码白烧掉（详见 MainActivity.pair 的注释）。
          挡住重建只是第一道，真正的保障是那边「拿到结果先落盘」。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          通知捕获。很多验证码走 App 推送而不是短信。
          需要用户在系统设置里手动授予「通知使用权」，无法用运行时权限申请。
        -->
        <service
            android:name=".notification.NotificationCapture"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.GatewayService"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".receiver.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="2147483647">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.PhoneStateReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!--
          开机自启。

          **不要加回 directBootAware / LOCKED_BOOT_COMPLETED。**
          那两条会让系统在**用户解锁之前**就拉起这个进程并执行 Application.onCreate，
          而 onCreate 第三行就是 Prefs(this) → getSharedPreferences。
          targetSdk ≥ 26 的应用在解锁前读凭据加密区会直接抛
          IllegalStateException（"SharedPreferences in credential encrypted storage
          are not available until after user is unlocked"），从 Application.onCreate
          里抛出来，整个进程当场死掉，onReceive 一行都没跑到。

          也就是说：**任何设了锁屏密码的机器，每次重启都在开机那一刻崩一次，
          网关不会自己起来。** Android 10 起出厂设备一律 FBE，而指纹解锁强制要先设
          PIN——所以这是常态，不是特例。家里那台白牌备用机没设锁屏，所以从没复现过，
          这正是这类 bug 只会被别人撞上的原因。

          留着也没有收益：解锁前 prefs、Room 队列、短信库全在凭据加密区，
          这个 App 在 direct boot 阶段本来就一件事都做不成。
        -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
