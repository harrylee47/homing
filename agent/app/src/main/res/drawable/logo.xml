<?xml version="1.0" encoding="utf-8"?>
<!--
  界面里用的 logo：**满幅**，viewport 就是 web/logo.svg 的 64。

  和 ic_launcher_foreground.xml 是同一只鸟、同一组路径，但那一份是给
  自适应图标用的：108 的画布、主体缩到中心 60（安全区要求，见 CLAUDE.md
  「Logo」那节）。把它直接塞进 ImageView 的话，四成多的方框是空的，
  40dp 的位置里鸟只有 22dp——看起来像素材没加载完。

  **一共四份，改了源要一起改**（vector drawable 没有 circle 元素，圆转成了弧路径）：
    web/logo.svg                    唯一的源
    drawable/logo.xml               这一份，满幅 64 画布，界面里用
    drawable/ic_launcher_foreground 自适应图标前景，108 画布、主体收在中心 60
    drawable/ic_launcher_monochrome Android 13+ 主题图标，剪影 + 眼睛镂空
    drawable/ic_notification        通知栏，剪影 + 眼睛镂空
  scripts/check-logo-sync.mjs 守着这件事，它挂在 deploy.sh 与 CI 上。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp" android:height="64dp"
    android:viewportWidth="64" android:viewportHeight="64">
    <!-- 身体：尾巴是同一条路径的一部分，不是拼上去的 -->
    <path android:fillColor="#66D9EF" android:strokeColor="#12100E" android:strokeWidth="3"
          android:strokeLineJoin="round" android:strokeLineCap="round"
          android:pathData="M47,27 C53,32 52,42 43,47 C34,52 22,49 17,43 L4,47 L12,34 C15,26 25,21 33,21 C40,21 45,23 47,27 Z"/>
    <!-- 翅膀：往左下让开头部，否则会被头压住、看起来像肚皮上的一块色 -->
    <path android:fillColor="#FFD93D" android:strokeColor="#12100E" android:strokeWidth="3"
          android:strokeLineJoin="round" android:strokeLineCap="round"
          android:pathData="M17,39 C19,28 29,24 38,30 C33,39 25,43 17,39 Z"/>
    <!-- 头 -->
    <path android:fillColor="#66D9EF" android:strokeColor="#12100E" android:strokeWidth="3"
          android:strokeLineJoin="round"
          android:pathData="M45,10.5 a10.5,10.5 0 1,0 0,21.0 a10.5,10.5 0 1,0 0,-21.0 Z"/>
    <!-- 喙 -->
    <path android:fillColor="#FFA552" android:strokeColor="#12100E" android:strokeWidth="3"
          android:strokeLineJoin="round" android:strokeLineCap="round"
          android:pathData="M54,18 L63,22 L54,26 Z"/>
    <!-- 眼睛：实心点。小尺寸下它是「这是只鸟」最强的信号 -->
    <path android:fillColor="#12100E"
          android:pathData="M48,15.5 a2.5,2.5 0 1,0 0,5.0 a2.5,2.5 0 1,0 0,-5.0 Z"/>
</vector>
